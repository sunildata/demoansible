# =============================================================================
# Ansible Inventory — Amazon Linux 2023 on AWS EC2
# =============================================================================
# master  172.31.42.76  — Control node (runs ansible-playbook FROM here)
# host1   172.31.38.10  — Managed target
# host2   172.31.32.228 — Managed target
#
# IMPORTANT: Replace "your-key.pem" with your actual EC2 key pair filename.
#            The .pem file must be on the master node at ~/.ssh/
#            Permissions: chmod 400 ~/.ssh/your-key.pem
# =============================================================================

[master]
master  ansible_host=172.31.42.76  ansible_connection=local  ansible_user=ec2-user

[managed]
host1   ansible_host=172.31.38.10   ansible_user=ec2-user  ansible_ssh_private_key_file=~/.ssh/your-key.pem
host2   ansible_host=172.31.32.228  ansible_user=ec2-user  ansible_ssh_private_key_file=~/.ssh/your-key.pem

# Group that includes all 3 servers (master + host1 + host2)
[all_servers:children]
master
managed
