# =============================================================================
# Target OS: RedHat Family (RHEL / CentOS / Rocky Linux / AlmaLinux / Fedora)
# =============================================================================

[demo_servers]
localhost ansible_connection=local

# For real RedHat remote servers, comment out localhost and use:
# rhel01 ansible_host=192.168.1.10 ansible_user=ec2-user ansible_ssh_private_key_file=~/.ssh/id_rsa
# rhel02 ansible_host=192.168.1.11 ansible_user=ec2-user ansible_ssh_private_key_file=~/.ssh/id_rsa

# Common ansible_user values per distro:
#   RHEL / CentOS stream  → ec2-user (AWS), cloud-user (GCP/Azure)
#   Rocky / AlmaLinux     → rocky, almalinux, or ec2-user
#   Fedora                → fedora
